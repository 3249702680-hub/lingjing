# Python 缓存与编译文件
__pycache__/
*.py[cod]
*.pyd

# 虚拟环境
.venv/
venv/
env/

# 构建与安装产物
build/
dist/
*.egg-info/

# 测试、类型检查与代码检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Notebook 临时文件与日志
.ipynb_checkpoints/
*.log

# 本地配置与凭据
.env
.env.*
!.env.example
.idea/
.vscode/

# 操作系统临时文件
.DS_Store
Thumbs.db
Desktop.ini

# 本地数据与实验产物；保留空目录标记
/data/*
!/data/.gitkeep
/outputs/*
!/outputs/.gitkeep
